# ============================================================
# DJANGO SETTINGS
# ============================================================
DEBUG=False
SECRET_KEY=your-very-secret-key-here-change-in-production-min-50-chars-random
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ENVIRONMENT=development

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL (Production)
DATABASE_URL=postgresql://user:password@localhost:5432/lams_db

# SQLite (Development - uncomment to use)
# DATABASE_URL=sqlite:///db.sqlite3

# ============================================================
# JWT SETTINGS
# ============================================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@leavemanagement.com

# ============================================================
# CORS & SECURITY
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ============================================================
# AWS S3 CONFIGURATION (Optional - for file uploads)
# ============================================================
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ============================================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================================
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=False

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Leave Approval Management System

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================================
# SECURITY HEADERS
# ============================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Enable these for production:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================================
# ADMIN CONFIGURATION
# ============================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
